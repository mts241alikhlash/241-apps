{
  "name": "admin-web",
  "private": true,
  "version": "0.1.0",
  "description": "241 Console: platform administration (users, roles, permissions, audit, files)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,vue,js}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,vue,js}\" --fix --max-warnings=0",
    "lint:strict": "eslint -c eslint.typecheck.config.mjs \"src/**/*.{ts,vue}\" --max-warnings=0",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run lint",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run lint:strict && pnpm run test && pnpm run build && pnpm run routes:check",
    "routes:check": "node --experimental-strip-types scripts/emit-routing-manifest.mjs --check",
    "routes:emit": "node --experimental-strip-types scripts/emit-routing-manifest.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "ci": "pnpm run validate"
  },
  "dependencies": {
    "@lucide/vue": "catalog:",
    "@mts241alikhlash/platform": "workspace:*",
    "@mts241alikhlash/reference-data": "workspace:*",
    "@mts241alikhlash/ui": "workspace:*",
    "@mts241alikhlash/web-shared": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "@tanstack/vue-table": "catalog:",
    "@unovis/ts": "catalog:",
    "@vee-validate/zod": "catalog:",
    "@vueuse/core": "catalog:",
    "axios": "catalog:",
    "leaflet": "catalog:",
    "pinia": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "vee-validate": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:",
    "vue-sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@mts241alikhlash/eslint-config": "workspace:*",
    "@mts241alikhlash/typescript-config": "workspace:*",
    "@mts241alikhlash/vitest-config": "workspace:*",
    "@types/leaflet": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
