{
  "name": "exam-web",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.16.1 <13"
  },
  "version": "0.2.0",
  "description": "241 Exam: question authoring, scheduling, grading, and the student exam sheet",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,vue,js}\" \"scripts/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,vue,js}\" \"scripts/**/*.ts\" --fix --max-warnings=0",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run lint",
    "validate": "pnpm run check:comments && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run routes:check",
    "routes:check": "node --experimental-strip-types scripts/emit-routing-manifest.mjs --check",
    "routes:emit": "node --experimental-strip-types scripts/emit-routing-manifest.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "check:comments": "node scripts/check-no-comments.mjs",
    "ci": "pnpm run validate"
  },
  "dependencies": {
    "@lucide/vue": "catalog:",
    "@mts241alikhlash/platform": "workspace:*",
    "@mts241alikhlash/ui": "workspace:*",
    "@mts241alikhlash/web-shared": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "@tanstack/vue-table": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-subscript": "catalog:",
    "@tiptap/extension-superscript": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/vue-3": "catalog:",
    "@vee-validate/zod": "catalog:",
    "@vueuse/core": "catalog:",
    "axios": "catalog:",
    "dompurify": "catalog:",
    "katex": "catalog:",
    "pinia": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "vee-validate": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:",
    "vue-sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@mts241alikhlash/eslint-config": "workspace:*",
    "@mts241alikhlash/academic-api": "workspace:*",
    "@mts241alikhlash/exam-api": "workspace:*",
    "@mts241alikhlash/student-api": "workspace:*",
    "@mts241alikhlash/typescript-config": "workspace:*",
    "@mts241alikhlash/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
