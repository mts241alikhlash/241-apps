{
  "name": "exam-web",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.16.1 <13"
  },
  "version": "0.1.0",
  "description": "241 Exam: question authoring, scheduling, grading, and the student exam sheet",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,vue,js}\" \"scripts/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,vue,js}\" \"scripts/**/*.ts\" --fix --max-warnings=0",
    "lint:strict": "eslint -c eslint.typecheck.config.mjs \"src/**/*.{ts,vue}\" \"scripts/**/*.ts\" --max-warnings=0",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run lint",
    "validate": "pnpm run check:comments && pnpm run lint && pnpm run typecheck && pnpm run lint:strict && pnpm run test && pnpm run build && pnpm run routes:check",
    "routes:check": "node --experimental-strip-types scripts/emit-routing-manifest.mjs --check",
    "routes:emit": "node --experimental-strip-types scripts/emit-routing-manifest.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "check:comments": "node scripts/check-no-comments.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "@mts241alikhlash/platform": "workspace:*",
    "@mts241alikhlash/ui": "workspace:*",
    "@mts241alikhlash/web-shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/vue-query": "^5.105.3",
    "@tanstack/vue-table": "^8.21.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@mts241alikhlash/eslint-config": "workspace:*",
    "@mts241alikhlash/typescript-config": "workspace:*",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.11.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.2.2",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.10"
  }
}
