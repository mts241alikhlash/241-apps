{
  "name": "account-web",
  "private": true,
  "version": "0.1.0",
  "description": "241 Accounts: sign-in, app launcher and own profile",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,vue,js}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,vue,js}\" --fix --max-warnings=0",
    "lint:strict": "eslint -c eslint.typecheck.config.mjs \"src/**/*.{ts,vue}\" --max-warnings=0",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run lint",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run lint:strict && pnpm run test && pnpm run build && pnpm run routes:check",
    "routes:check": "node --experimental-strip-types scripts/emit-routing-manifest.mjs --check",
    "routes:emit": "node --experimental-strip-types scripts/emit-routing-manifest.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@fullcalendar/core": "catalog:",
    "@fullcalendar/daygrid": "catalog:",
    "@fullcalendar/interaction": "catalog:",
    "@fullcalendar/vue3": "catalog:",
    "@internationalized/date": "catalog:",
    "@lucide/vue": "catalog:",
    "@mts241alikhlash/platform": "workspace:*",
    "@mts241alikhlash/ui": "workspace:*",
    "@mts241alikhlash/web-shared": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "@tanstack/vue-table": "catalog:",
    "@types/qrcode": "catalog:",
    "@unovis/ts": "catalog:",
    "@unovis/vue": "catalog:",
    "@vee-validate/zod": "catalog:",
    "@vueuse/core": "catalog:",
    "axios": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "leaflet": "catalog:",
    "pinia": "catalog:",
    "qrcode": "catalog:",
    "reka-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "vee-validate": "catalog:",
    "vue": "catalog:",
    "vue-chrts": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:",
    "vue-sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@mts241alikhlash/eslint-config": "workspace:*",
    "@mts241alikhlash/typescript-config": "workspace:*",
    "@mts241alikhlash/vitest-config": "workspace:*",
    "@types/leaflet": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "10.1.8",
