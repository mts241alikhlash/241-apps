{
  "name": "assessment-service",
  "version": "0.1.1",
  "description": "241 Academic — teaching evaluation: assessment, attendance, report cards, dashboard",
  "author": "mhrmnvl",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.16.1 <13"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,test,prisma}/**/*.ts\" --fix --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "openapi:emit": "nest build && node dist/src/openapi/emit-openapi.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@mts241alikhlash/nest-core": "workspace:*",
