enum ExamSessionStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  GRADED
}

enum ScorePublicationStatus {
  PENDING
  SENT
}

model ExamSession {
  id           String            @id @default(uuid()) @db.Uuid
  scheduleId   String            @map("schedule_id") @db.Uuid
  studentId    String            @map("student_id") @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  deviceId     String?           @map("device_id") @db.VarChar(100)
  enrollmentId String?           @map("enrollment_id") @db.Uuid
  shuffleSeed  String            @map("shuffle_seed") @db.VarChar(32)
  startedAt    DateTime          @map("started_at")
  deadline     DateTime
  finalizeAt   DateTime          @map("finalize_at")
  status       ExamSessionStatus @default(IN_PROGRESS)
  submittedAt  DateTime?         @map("submitted_at")
  rawScore     Float?            @map("raw_score")
  maxScore     Float?            @map("max_score")
  releasedAt   DateTime?         @map("released_at")
  releasedById String?           @map("released_by_id") @db.Uuid
  gradedAt     DateTime?         @map("graded_at")
  violationCount Int             @default(0) @map("violation_count")
  lastSeenAt     DateTime?       @map("last_seen_at")
  absentSince    DateTime?       @map("absent_since")
  roomId         String?         @map("room_id") @db.Uuid
  seatNumber     Int?            @map("seat_number")
  requiresTokenReentry Boolean   @default(false) @map("requires_token_reentry")
  lockedByViolation    Boolean   @default(false) @map("locked_by_violation")
  allowWebClient       Boolean   @default(false) @map("allow_web_client")
  allowLateEntry       Boolean   @default(false) @map("allow_late_entry")
  extraMinutes         Int       @default(0) @map("extra_minutes")
  kioskMode            String    @default("PINNED") @map("kiosk_mode") @db.VarChar(32)
  syncedAnswerCount Int          @default(0) @map("synced_answer_count")
  unsyncedCount  Int             @default(0) @map("unsynced_count")
  lastBatteryLevel Int?          @map("last_battery_level")
  isCharging     Boolean?        @map("is_charging")
  policy         Json?
  dndGranted     Boolean?        @map("dnd_granted")
  lockTaskActive Boolean?        @map("lock_task_active")
  batteryUnrestricted Boolean?   @map("battery_unrestricted")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  schedule    ExamSchedule      @relation(fields: [scheduleId], references: [id])
  room        ExamRoom?         @relation(fields: [roomId], references: [id])
  answers     ExamAnswer[]
  publication ScorePublication?
  events      ExamSessionEvent[]

  @@unique([scheduleId, studentId])
  @@index([status, finalizeAt])
  @@index([roomId])
  @@map("exam_sessions")
}

model ExamAnswer {
  id                    String    @id @default(uuid()) @db.Uuid
  sessionId             String    @map("session_id") @db.Uuid
  questionId            String    @map("question_id") @db.Uuid
  answer                Json
  clientId              String    @map("client_id") @db.VarChar(64)
  receivedAfterDeadline Boolean   @default(false) @map("received_after_deadline")
  score                 Float?
  gradedById            String?   @map("graded_by_id") @db.Uuid
  gradedAt              DateTime? @map("graded_at")
  gradeNote             String?   @map("grade_note") @db.VarChar(500)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  session  ExamSession @relation(fields: [sessionId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@unique([sessionId, clientId])
  @@index([questionId])
  @@map("exam_answers")
}

model ExamAccessAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  scheduleId  String    @map("schedule_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([scheduleId, studentId])
  @@map("exam_access_attempts")
}

model ScorePublication {
  id                String                 @id @default(uuid()) @db.Uuid
  sessionId         String                 @unique @map("session_id") @db.Uuid
  status            ScorePublicationStatus @default(PENDING)
  attempts          Int                    @default(0)
  permanentFailures Int                    @default(0) @map("permanent_failures")
  lastError         String?                @map("last_error") @db.VarChar(300)
  lastAttemptAt     DateTime?              @map("last_attempt_at")
  sentAt            DateTime?              @map("sent_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  session ExamSession @relation(fields: [sessionId], references: [id])

  @@index([status, lastAttemptAt])
  @@map("score_publications")
}

enum SessionEventType {
  PERMISSION_DIALOG
  SCREEN_OFF
  FOCUS_LOST_BRIEF
  OVERLAY_OR_SHADE
  CALL_OR_MIC_ACTIVE
  ABSENCE_GAP
  SCREEN_SHARE_DETECTED
  LEFT_APP
  VIOLATION_LOCKED
  CALL_SUSPENDED
}

model ExamSessionEvent {
  id          String           @id @default(uuid()) @db.Uuid
  sessionId   String           @map("session_id") @db.Uuid
  clientId    String           @map("client_id") @db.VarChar(64)
  type        SessionEventType
  isViolation Boolean          @default(false) @map("is_violation")
  detail      String?          @db.VarChar(200)
  occurredAt  DateTime         @map("occurred_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientId])
  @@index([sessionId, occurredAt])
  @@map("exam_session_events")
}

enum SessionAuditAction {
  RELEASE_DEVICE
  REOPEN_SESSION
  RESET_SESSION
  EXTEND_TIME
  ALLOW_WEB_CLIENT
  ALLOW_LATE_ENTRY
  ROTATE_ROOM_TOKEN
  SUBSTITUTE_SUPERVISOR
  ASSIGN_SUPERVISOR
  SUBMIT_ROOM_REPORT
  VERIFY_ROOM_REPORT
  REOPEN_ROOM_REPORT
  CLOSED_BY_ADMIN
}

model ExamSessionAuditLog {
  id         String             @id @default(uuid()) @db.Uuid
  sessionId  String?            @map("session_id") @db.Uuid
  roomId     String?            @map("room_id") @db.Uuid
  scheduleId String?            @map("schedule_id") @db.Uuid
  action     SessionAuditAction
  actorId    String             @map("actor_id") @db.Uuid
  reason     String             @db.VarChar(300)
  metadata   Json               @default("{}")
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@index([roomId, createdAt])
  @@map("exam_session_audit_logs")
}
