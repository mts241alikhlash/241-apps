enum ExamEventStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

model ExamEvent {
  id                   String          @id @default(uuid()) @db.Uuid
  semesterId           String          @map("semester_id") @db.Uuid
  name                 String          @db.VarChar(150)
  type                 ExamType
  startsAt             DateTime        @map("starts_at")
  endsAt               DateTime        @map("ends_at")
  lateToleranceMinutes Int             @default(30) @map("late_tolerance_minutes")
  minSubmitMinutes     Int             @default(20) @map("min_submit_minutes")
  requireAndroidApp    Boolean         @default(true) @map("require_android_app")
  status               ExamEventStatus @default(DRAFT)
  createdById          String          @map("created_by_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  rooms     ExamRoom[]
  schedules ExamSchedule[]

  @@index([semesterId, status])
  @@map("exam_events")
}

model ExamRoom {
  id               String   @id @default(uuid()) @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  code             String   @db.VarChar(30)
  name             String   @db.VarChar(100)
  building         String?  @db.VarChar(100)
  capacity         Int
  technicianUserId String?  @map("technician_user_id") @db.Uuid
  tokenRotation    Int      @default(0) @map("token_rotation")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  event       ExamEvent            @relation(fields: [eventId], references: [id])
  seats       ExamRoomSeat[]
  supervisors ExamRoomSupervisor[]
  sessions    ExamSession[]
  reports     ExamRoomReport[]

  @@unique([eventId, code])
  @@index([technicianUserId])
  @@map("exam_rooms")
}

model ExamRoomSeat {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  classroomId     String   @map("classroom_id") @db.Uuid
  seatNumber      Int      @map("seat_number")
  allowWebClient  Boolean  @default(false) @map("allow_web_client")
  allowLateEntry  Boolean  @default(false) @map("allow_late_entry")
  createdAt       DateTime @default(now()) @map("created_at")

  room ExamRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@unique([roomId, seatNumber])
  @@index([studentId])
  @@map("exam_room_seats")
}

model ExamRoomSupervisor {
  id                   String    @id @default(uuid()) @db.Uuid
  roomId               String    @map("room_id") @db.Uuid
  startsAt             DateTime  @map("starts_at")
  endsAt               DateTime  @map("ends_at")
  scheduledUserId      String    @map("scheduled_user_id") @db.Uuid
  actualUserId         String    @map("actual_user_id") @db.Uuid
  substitutedByAdminId String?   @map("substituted_by_admin_id") @db.Uuid
  substituteReason     String?   @map("substitute_reason") @db.VarChar(200)
  substitutedAt        DateTime? @map("substituted_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  room ExamRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startsAt, endsAt])
  @@index([actualUserId, startsAt, endsAt])
  @@map("exam_room_supervisors")
}

enum RoomReportStatus {
  DRAFT
  SUBMITTED
  VERIFIED
}

enum RoomExecutionCondition {
  SMOOTH
  TECHNICAL_ISSUE
  DISCIPLINARY_NOTE
}

model ExamRoomReport {
  id                String                 @id @default(uuid()) @db.Uuid
  roomId            String                 @map("room_id") @db.Uuid
  supervisorSlotId  String                 @unique @map("supervisor_slot_id") @db.Uuid
  condition         RoomExecutionCondition @default(SMOOTH)
  incidentNotes     String?                @map("incident_notes") @db.Text
  submittedByUserId String?                @map("submitted_by_user_id") @db.Uuid
  submittedAt       DateTime?              @map("submitted_at")
  verifiedByUserId  String?                @map("verified_by_user_id") @db.Uuid
  verifiedAt        DateTime?              @map("verified_at")
  status            RoomReportStatus       @default(DRAFT)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  room       ExamRoom                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  absences   ExamRoomReportAbsence[]
  fieldNotes ExamRoomFieldNote[]

  @@index([roomId, status])
  @@map("exam_room_reports")
}

model ExamRoomReportAbsence {
  id         String       @id @default(uuid()) @db.Uuid
  reportId   String       @map("report_id") @db.Uuid
  studentId  String       @map("student_id") @db.Uuid
  scheduleId String       @map("schedule_id") @db.Uuid
  reason     MakeupReason
  note       String?      @db.VarChar(200)
  recordedBy String       @map("recorded_by") @db.Uuid
  updatedAt  DateTime     @updatedAt @map("updated_at")

  report ExamRoomReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, studentId, scheduleId])
  @@index([scheduleId, studentId])
  @@map("exam_room_report_absences")
}

model ExamRoomFieldNote {
  id         String   @id @default(uuid()) @db.Uuid
  reportId   String   @map("report_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  sessionId  String?  @map("session_id") @db.Uuid
  category   String   @db.VarChar(50)
  note       String   @db.VarChar(300)
  recordedBy String   @map("recorded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  report ExamRoomReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, studentId])
  @@map("exam_room_field_notes")
}
