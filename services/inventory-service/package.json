{
  "name": "inventory-service",
  "version": "0.1.1",
  "description": "241 Inventory — assets, units, circulation, approvals",
  "author": "mhrmnvl",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.16.1 <13"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix --max-warnings=0",
    "lint:strict": "eslint -c eslint.typecheck.config.mjs \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run lint:strict && pnpm test && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:emit": "nest build && node dist/src/openapi/emit-openapi.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run lint:strict && pnpm run test && pnpm run build",
    "test:e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@mts241alikhlash/nest-core": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/passport": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "cookie-parser": "catalog:",
    "dotenv": "catalog:",
    "helmet": "catalog:",
    "nestjs-pino": "catalog:",
    "passport": "catalog:",
    "passport-jwt": "catalog:",
    "pino-http": "catalog:",
    "pino-pretty": "catalog:",
    "prisma": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mts241alikhlash/eslint-config": "workspace:*",
    "@mts241alikhlash/typescript-config": "workspace:*",
    "@mts241alikhlash/vitest-config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/passport-jwt": "catalog:",
    "@types/supertest": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "supertest": "catalog:",
    "ts-loader": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
