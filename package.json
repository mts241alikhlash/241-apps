{
  "name": "241-apps",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.16.1 <13"
  },
  "scripts": {
    "check": "pnpm -r --if-present run check",
    "test": "pnpm -r --if-present run test",
    "changeset": "changeset",
    "runtime:check": "node --test scripts/runtime-config.spec.mjs scripts/lint-staged-eslint.spec.mjs scripts/check-docs.spec.mjs scripts/check-permissions.spec.mjs scripts/check-comments.spec.mjs scripts/check-contract-compatibility.spec.mjs .github/scripts/require-changeset.spec.mjs .github/scripts/dependabot-changeset.spec.mjs scripts/affected.spec.mjs scripts/release-targets.spec.mjs scripts/release-version.spec.mjs .github/scripts/changelog-section.spec.mjs",
    "openapi:emit": "node scripts/emit-openapi.mjs",
    "openapi:check": "node scripts/emit-openapi.mjs --check",
    "db:smoke": "node scripts/db-smoke.mjs",
    "version:check": "node scripts/check-contract-versions.mjs",
    "api:generate": "node scripts/generate-api-clients.mjs",
    "api:check": "node scripts/generate-api-clients.mjs --check",
    "api:typecheck": "pnpm --filter '@mts241alikhlash/*-api' --if-present run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check . && node scripts/check-docs.mjs && pnpm -r --if-present run lint",
    "fix": "prettier --write . && pnpm -r --if-present run lint --fix",
    "prepare": "husky",
    "knip": "DATABASE_URL=postgresql://knip:knip@localhost:5432/knip DIRECT_URL=postgresql://knip:knip@localhost:5432/knip knip",
    "docs:check": "node scripts/check-docs.mjs",
    "test:e2e": "pnpm -r --if-present run test:e2e"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.5.43",
    "vue-tsc": "catalog:"
  },
  "version": "0.1.0"
}
